# ==============================================================================
# DP AGRON - Environment variables (copy to .env.local and fill in)
# .env.local is git-ignored. On Vercel, set these in Project Settings -> Environment Variables.
# ==============================================================================

# Google AI Studio key for the AI advisor (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# WordPress / WooCommerce on Papaki (no trailing slash)
WC_STORE_URL=https://pgagron.hustlelabs.gr

# WooCommerce REST API keys - ONLY for scripts/sync-woocommerce.js (never exposed to the browser)
# Create READ-ONLY keys: WP Admin -> WooCommerce -> Settings -> Advanced -> REST API
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
